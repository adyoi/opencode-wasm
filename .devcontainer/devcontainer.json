{
  "name": "opencode-wasm server",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": {
      "label": "opencode",
      "onAutoForward": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"]
    }
  }
}
